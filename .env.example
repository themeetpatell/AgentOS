# ============================================================================
# Finanshels Neuro - Environment Variables
# Copy this file to .env (root) and apps/{web,api}/.env as appropriate.
# ============================================================================

NODE_ENV=development

# --- Local dev mode (run with just an Anthropic key) ---
# When set, the API uses an in-memory Firestore shim, runs Cloud Tasks
# in-process (HTTP self-call, no queue), and accepts a dev-token bypass on
# the auth guard. The web sign-in page becomes one click ("continue as
# dev@finanshels.com"). No Firebase project, no GCP, no Zoho required.
NEURO_LOCAL_DEV=1
NEXT_PUBLIC_NEURO_LOCAL_DEV=1

# --- GCP ---
GCP_PROJECT_ID=finanshels-neuro-dev
GCP_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Firebase ---
FIREBASE_PROJECT_ID=finanshels-neuro-dev
FIREBASE_AUTH_DOMAIN=finanshels-neuro-dev.firebaseapp.com
FIREBASE_AUTH_ALLOWED_DOMAIN=finanshels.com

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=finanshels-neuro-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=finanshels-neuro-dev
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- API (apps/api) ---
PORT=3000
WEB_ORIGIN=http://localhost:3001

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PLAN=claude-opus-4-7
ANTHROPIC_MODEL_EXECUTE=claude-sonnet-4-6
ANTHROPIC_MODEL_LIGHT=claude-haiku-4-5-20251001

# --- Cloud Tasks ---
CLOUD_TASKS_QUEUE=agent-runs
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_WORKER_URL=http://localhost:3000
CLOUD_TASKS_INVOKER_SA=

# --- Optional: publish hook to finanshels_web CMS ---
FINANSHELS_WEB_PUBLISH_URL=
FINANSHELS_WEB_PUBLISH_TOKEN=

# --- Zoho CRM (Sprint 4: sales + pre-sales agents) ---
# Self-client OAuth2: api-console.zoho.com -> Self Client.
# Scopes: ZohoCRM.modules.ALL, ZohoCRM.modules.notes.ALL, ZohoCRM.modules.tasks.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Region defaults to .com (US). For .eu / .in / .ae change both:
ZOHO_API_BASE=https://www.zohoapis.com
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.com
